# =============================================================================
# SourceBD — environment template
# Copy to .env and fill values. NEVER commit .env.
# =============================================================================

# --- Supabase (project: stnrfxrxfonwexzcvvpv) ---
SUPABASE_URL=https://stnrfxrxfonwexzcvvpv.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooled connection string (Supabase Dashboard -> Connect -> Transaction pooler)
SUPABASE_DB_URL=postgresql://postgres.stnrfxrxfonwexzcvvpv:YOUR-DB-PASSWORD@aws-1-us-west-1.pooler.supabase.com:6543/postgres

# --- Next.js public (Phase 4+) ---
NEXT_PUBLIC_SUPABASE_URL=https://stnrfxrxfonwexzcvvpv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://sourcebd.net
NEXT_PUBLIC_SITE_URL=https://sourcebd.net

# --- Cloudflare (DNS automation) ---
# API Token created in Cloudflare dashboard → My Profile → API Tokens
# Required permissions: Zone:DNS:Edit, Zone:Zone:Read for sourcebd.net
CLOUDFLARE_API_TOKEN=

# --- OneProvider (deployment target, Phase 4+) ---
ONEPROVIDER_API_KEY=
ONEPROVIDER_CLIENT_KEY=
ONEPROVIDER_API_BASE=https://api.oneprovider.com

# --- ETL runtime ---
ETL_USER_AGENT=SourceBD-Research/1.0 (+https://sourcebd.net/data-policy)
ETL_RAW_DIR=./etl/raw
ETL_PARSED_DIR=./etl/parsed
ETL_LOG_LEVEL=INFO
ETL_RATE_LIMIT_RPS=0.5          # default global cap (requests per second)
ETL_MAX_RETRIES=5
ETL_RETRY_BACKOFF_BASE=2.0
ETL_PLAYWRIGHT_HEADLESS=true

# --- Third-party (Phase 1+) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# --- Email (Spec H4) ---
RESEND_API_KEY=
RESEND_FROM=SourceBD <noreply@sourcebd.net>

# --- Observability (Spec H1) ---
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Firecrawl (web acquisition layer; Hard-Rule-4 exception 29 Jul 2026) ---
# Server-only. Never add a NEXT_PUBLIC_ variant — the key must not reach a browser.
# We request markdown + rawHtml only (1 credit/page) and parse deterministically
# in our own code; Firecrawl's LLM `json` mode is deliberately never used for
# registry facts. See context/architecture.md -> Data layer.
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_MS=60000
FIRECRAWL_MAX_CONCURRENCY=8      # keep <= your plan's concurrent-request limit
# Hard ceiling on billable credits a SINGLE run may spend; 0 disables the guard.
# Checked before each fetch using Firecrawl's documented pricing, and a run that
# would pass the ceiling ABORTS rather than stopping early — a half-scraped
# registry that looks complete is worse than a failed run, because it silently
# ages out every record it never reached. Size it above a legitimate full run:
# bgmea_web is roughly one list page per 20 members plus one page per member.
FIRECRAWL_MAX_CREDITS_PER_RUN=0
# Shared secret the Firecrawl monitor webhook must present back to
# /api/v1/webhooks/firecrawl. Generate with: openssl rand -hex 32
FIRECRAWL_WEBHOOK_SECRET=
# Public origin used when registering monitor webhooks (e.g. https://sourcebd.net)
FIRECRAWL_WEBHOOK_BASE_URL=

# --- Optional source APIs ---
COMPANIES_HOUSE_KEY=

# --- Legal (Spec H7) — public, render on /legal/privacy ---
# When unset, the Privacy page renders explicit "Pending …" sentinels.
# Flip these on the VPS once the ICO registration is paid and the UK
# GDPR Representative contract is signed; no redeploy gate beyond an env reload.
NEXT_PUBLIC_ICO_REGISTRATION_NUMBER=
NEXT_PUBLIC_UK_GDPR_REP_NAME=
NEXT_PUBLIC_UK_GDPR_REP_ADDRESS=
NEXT_PUBLIC_UK_GDPR_REP_EMAIL=

# --- Backup + restore drill (Spec H8) ---
# Pooler URL of the SECOND Supabase project used as the restore target
# for the quarterly drill (see docs/runbooks/backup-restore.md). Must
# be distinct from SUPABASE_DB_URL — the verifier refuses to run
# against production. Server-only; no NEXT_PUBLIC_ prefix.
RESTORE_TARGET_DATABASE_URL=

# --- BunnyCDN (Phase 0.5+ document mirror; specs 09, 13, 15) ---
# Get values from: Bunny dashboard -> Storage / Pull Zones
BUNNY_API_KEY=                  # account-level API key (used to manage zones)
BUNNY_STORAGE_ZONE=             # e.g. sourcebd-docs
BUNNY_STORAGE_PASSWORD=         # per-storage-zone access password
BUNNY_STORAGE_REGION=           # '' (global), 'de', 'ny', 'la', 'sg', 'syd'
BUNNY_STORAGE_HOSTNAME=         # usually storage.bunnycdn.com (or <region>.storage.bunnycdn.com)
BUNNY_PULL_ZONE_HOSTNAME=       # e.g. sourcebd-docs.b-cdn.net or cdn.sourcebd.com
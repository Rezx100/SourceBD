# --- Next.js public (Phase 4+) ---
NEXT_PUBLIC_SUPABASE_URL=https://stnrfxrxfonwexzcvvpv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OneProvider (deployment target, Phase 4+) ---
ONEPROVIDER_API_KEY=
ONEPROVIDER_CLIENT_KEY=
ONEPROVIDER_API_BASE=https://api.oneprovider.com

# --- ETL runtime ---
ETL_USER_AGENT=SourceBD-Research/1.0 (+https://sourcebd.com/data-policy)
ETL_RAW_DIR=./etl/raw
ETL_PARSED_DIR=./etl/parsed
ETL_LOG_LEVEL=INFO
ETL_RATE_LIMIT_RPS=0.5          # default global cap (requests per second)
ETL_MAX_RETRIES=5
ETL_RETRY_BACKOFF_BASE=2.0
ETL_PLAYWRIGHT_HEADLESS=true

# --- Third-party (Phase 1+) ---
RESEND_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# --- Observability (Spec H1) ---
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Optional source APIs ---
COMPANIES_HOUSE_KEY=

# --- BunnyCDN (Phase 0.5+ document mirror; specs 09, 13, 15) ---
# Get values from: Bunny dashboard -> Storage / Pull Zones
BUNNY_API_KEY=                  # account-level API key (used to manage zones)
BUNNY_STORAGE_ZONE=             # e.g. sourcebd-docs
BUNNY_STORAGE_PASSWORD=         # per-storage-zone access password
BUNNY_STORAGE_REGION=           # '' (global), 'de', 'ny', 'la', 'sg', 'syd'
BUNNY_STORAGE_HOSTNAME=         # usually storage.bunnycdn.com (or <region>.storage.bunnycdn.com)
BUNNY_PULL_ZONE_HOSTNAME=       # e.g. sourcebd-docs.b-cdn.net or cdn.sourcebd.com
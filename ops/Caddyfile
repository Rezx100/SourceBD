# Spec P1 — Caddy reverse proxy for the SourceBD web container.
#
# HTTP-only on port 80 against the bare VPS IP (109.104.153.228). When the
# DNS CNAME lands, swap the `:80` block for a `sourcebd.com {` block — Caddy
# will then auto-provision a Let's Encrypt cert on first request.
#
# The `web` container listens on 127.0.0.1:3000 (compose port mapping); only
# Caddy is exposed publicly on :80. This keeps the Next.js port off the
# internet and lets us add HSTS / TLS / rate limits at the proxy layer
# without touching the app.

{
	# Server-wide options.
	admin off
	persist_config off
	auto_https off
}

:80 {
	encode zstd gzip

	# Health probe upstream so a stuck container is recycled by Caddy's
	# active health checks rather than only by Docker's HEALTHCHECK.
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Proto http
		header_up X-Forwarded-Host {host}
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	# Hide the proxy.
	header -Server

	log {
		output file /var/log/caddy/sourcebd-access.log {
			roll_size 50mb
			roll_keep 5
		}
		format console
	}
}

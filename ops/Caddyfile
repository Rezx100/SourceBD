# SourceBD — Caddy reverse proxy.
#
# Cloudflare proxies all HTTPS for sourcebd.net (orange cloud ON). CF
# terminates TLS with the user's browser, then forwards to this server.
#
# CF SSL/TLS mode: Full (not Flexible, not Strict).
#   - :80  accepts HTTP from CF when it probes over plain HTTP
#   - :443 accepts HTTPS from CF with an internally-generated self-signed cert
#           (CF Full mode validates the connection but not the cert authority)
#
# Traffic flow:
#   User → CF (443 HTTPS) → VPS :443 (Caddy + self-signed) → 127.0.0.1:3000

{
	admin off
	persist_config off
	# auto_https is off — we manage TLS manually with `tls internal` below.
	auto_https off
}

# HTTPS listener — used by Cloudflare in Full mode.
:443 {
	tls internal {
		on_demand
	}

	encode zstd gzip

	# No health_uri: Caddy active checks mark the upstream unhealthy
	# for a full health_interval (30s) after a container restart, so
	# public /api/health returns 503 while 127.0.0.1:3000 is already
	# OK. Docker HEALTHCHECK + ops/deploy_vps.sh wait instead.
	reverse_proxy 127.0.0.1:3000 {
		# Tell Next.js the original scheme was HTTPS.
		header_up X-Forwarded-Proto https
		# Pass the real client IP from Cloudflare's header.
		header_up X-Real-IP {header.CF-Connecting-IP}
	}

	header -Server

	log {
		output file /var/log/caddy/sourcebd-access.log {
			roll_size 50mb
			roll_keep 5
		}
		format console
	}
}

# HTTP listener — handles direct bare-IP probes and let CF redirect to HTTPS.
:80 {
	encode zstd gzip

	# No health_uri — see :443 reverse_proxy comment.
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Proto http
		header_up X-Real-IP {header.CF-Connecting-IP}
	}

	header -Server
}

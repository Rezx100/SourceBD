# Spec P1 — Next.js production image (standalone output, non-root, healthcheck).
#
# Three-stage build:
#   1. deps    — install node_modules with pnpm from the workspace lockfile.
#   2. builder — copy source, run `pnpm build` to emit .next/standalone +
#                .next/static.
#   3. runner  — alpine base, copies only the standalone bundle + static
#                assets + public/. Runs as non-root user `nextjs`.

# --- deps -------------------------------------------------------------------
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# --- builder ----------------------------------------------------------------
FROM node:20-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
# Sentry uploads source maps only when SENTRY_AUTH_TOKEN is set; deploy
# without it for a quiet build, then re-deploy with the token on the VPS.
RUN pnpm build

# --- runner -----------------------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Non-root user. UID/GID 1001 mirrors the Next.js Vercel reference image.
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# Standalone output ships its own minimal node_modules + server.js.
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

# Healthcheck calls the public /api/health route (no auth, no DB). Caddy
# also probes the same endpoint upstream — keeping both is intentional
# defence in depth.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "server.js"]
